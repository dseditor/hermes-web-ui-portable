# syntax=docker/dockerfile:1
# ============================================================================
#  Hermes Web UI — FRONTEND-ONLY image
#
#  This image contains ONLY the web UI (the optimized fork). It does NOT
#  bundle the Hermes agent / Python core. At runtime it forwards every chat
#  run to a REMOTE Hermes API server (e.g. a hermes-agent running in another
#  Docker container / another machine) via its OpenAI-compatible
#  POST /v1/responses endpoint.
#
#  Enable remote mode with:
#    HERMES_REMOTE_API_URL  = http://<host>:8642   (the remote agent's API server)
#    HERMES_REMOTE_API_KEY  = <token>              (must match its API_SERVER_KEY)
#
#  The remote hermes-agent must be started with:
#    API_SERVER_ENABLED=true
#    API_SERVER_HOST=0.0.0.0
#    API_SERVER_PORT=8642
#    API_SERVER_KEY=<token>
#  ...and the port published (e.g. docker run -p 8642:8642).
#
#  Build:   docker build -f Dockerfile.frontend -t hermes-web-ui-frontend .
#  Or use:  docker compose -f docker-compose.remote.yml up -d --build
# ============================================================================
ARG NODE_VERSION=24.15.0
FROM node:${NODE_VERSION}-bookworm-slim

# Build toolchain for the single native dependency (node-pty). python3/make/g++
# are node-gyp build tooling only — NOT the Hermes agent runtime.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Install cloudflared so the in-app "external pairing" tunnel works in Linux/Docker
# (this image runs the web-ui server, which owns the pairing/tunnel feature).
RUN ARCH=$(dpkg --print-architecture) \
    && echo "Downloading cloudflared for ${ARCH}" \
    && curl -fsSL "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${ARCH}" \
       -o /usr/local/bin/cloudflared \
    && chmod +x /usr/local/bin/cloudflared \
    && cloudflared --version

WORKDIR /app

# Install deps first (better layer caching). node-pty is rebuilt explicitly.
COPY package*.json ./
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm ci --ignore-scripts && npm rebuild node-pty

# Build the client + server bundle, then drop dev dependencies.
COPY . .
RUN npm run build && npm prune --omit=dev

ENV NODE_ENV=production
# Persist the web-ui DB / auth token / session history here (mount a volume).
ENV HERMES_WEB_UI_HOME=/data
ENV PORT=8648
# Enable the external-pairing tunnel via the cloudflared installed above.
ENV HERMES_TUNNEL_CLOUDFLARED=/usr/local/bin/cloudflared
# Remote backend (set real values at runtime / via compose .env).
ENV HERMES_REMOTE_API_URL=""
ENV HERMES_REMOTE_API_KEY=""

RUN mkdir -p /data
EXPOSE 8648

# Run the server directly (no Python agent bridge is started in remote mode).
ENTRYPOINT ["node", "dist/server/index.js"]
CMD []
