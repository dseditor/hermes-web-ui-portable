# ============================================================================
#  Hermes Web UI (frontend-only) — remote backend configuration
#  Copy to ".env" next to docker-compose.remote.yml and fill in the values.
#    cp .env.remote.example .env
# ============================================================================

# URL of the remote hermes-agent's OpenAI-compatible API server.
# The remote agent must run with API_SERVER_ENABLED=true, API_SERVER_HOST=0.0.0.0,
# API_SERVER_PORT=8642 and the port published.
#   - remote machine:        http://192.168.1.100:8642
#   - same-host container:    http://hermes-agent:8642   (shared docker network)
HERMES_REMOTE_API_URL=http://192.168.1.100:8642

# Bearer token for the remote API server. MUST match the remote agent's
# API_SERVER_KEY exactly.
HERMES_REMOTE_API_KEY=change-me-to-match-API_SERVER_KEY

# --- Optional ---
# Host port to expose the web UI on (container always listens on 8648).
# PORT=8648
# Where to persist the web-ui DB / token / chat history on the host.
# WEBUI_DATA_DIR=./webui_data
# Image / container names.
# WEBUI_IMAGE=hermes-web-ui-frontend:latest
# WEBUI_CONTAINER_NAME=hermes-webui-frontend
